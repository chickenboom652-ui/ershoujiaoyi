<view class="container"><view class="welcome"><view class="title">你好，同学</view><view class="muted">把闲置分享给需要它的人。</view><button wx:if="{{!user}}" class="primary" bindtap="login">登录账号</button><view wx:else class="muted">{{user.name}}</view></view><view class="profile-menu"><view bindtap="favorites">♡ 我想要的 <text>›</text></view><view bindtap="showPublished">♧ 我发布的 <text>管理发布 ›</text></view><view bindtap="favorites">♡ 我的收藏 <text>›</text></view></view><block wx:if="{{viewingPublished}}"><view class="section-title">我的发布</view><view wx:if="{{loading}}" class="loading">加载中…</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="grid"><view class="card" wx:for="{{items}}" wx:key="id"><image class="card-img" src="{{item.photos[0].url}}" mode="aspectFill" data-id="{{item.id}}" bindtap="detail"/><view class="card-body" data-id="{{item.id}}" bindtap="detail"><view class="card-title">{{item.title}}</view><view class="price">¥{{item.priceLabel}}</view><text class="tag">{{item.statusLabel}}</text></view><view wx:if="{{item.review_note}}" class="note">审核说明：{{item.review_note}}</view><view class="action-row"><button class="secondary" bindtap="edit" data-id="{{item.id}}">编辑</button><button wx:if="{{item.status === 'active'}}" class="secondary" bindtap="status" data-id="{{item.id}}" data-status="sold" disabled="{{busy}}">已售</button><button wx:if="{{item.status === 'active' || item.status === 'pending'}}" class="secondary" bindtap="status" data-id="{{item.id}}" data-status="hidden" disabled="{{busy}}">下架</button><button wx:else class="secondary" bindtap="status" data-id="{{item.id}}" data-status="pending" disabled="{{busy}}">重新送审</button></view></view></view><view wx:if="{{user &amp;&amp; !loading &amp;&amp; !items.length}}" class="empty">你的第一件闲置，正等着出发。</view></block><button class="text-button" bindtap="policy">使用须知与隐私说明</button><button wx:if="{{user}}" class="text-button" bindtap="logout">退出登录</button></view>
