<view class="container"><view class="eyebrow">YOUR GOOD FINDS</view><view class="section-title">我的收藏</view><view class="muted">把心动的好物留在这里。</view><view wx:if="{{!loggedIn}}" class="empty">登录后查看收藏<button class="primary" bindtap="login">登录账号</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="grid list"><view class="card" wx:for="{{items}}" wx:key="id"><view data-id="{{item.id}}" data-unavailable="{{item.unavailable}}" bindtap="detail"><image wx:if="{{!item.unavailable}}" class="card-img" src="{{item.photos[0].url}}" mode="aspectFill"/><view class="card-body"><view class="card-title">{{item.title}}</view><view wx:if="{{!item.unavailable}}" class="price">¥{{item.priceLabel}}</view><view wx:else class="muted">已售出、下架或重新审核</view></view></view><view class="action-row"><button class="secondary" data-id="{{item.id}}" bindtap="remove">取消收藏</button></view></view></view><view wx:if="{{loggedIn &amp;&amp; !loading &amp;&amp; !items.length}}" class="empty">遇到心动好物，点一下收藏。</view><view wx:if="{{loading}}" class="loading">加载中…</view></view>
