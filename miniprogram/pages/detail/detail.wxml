<view class="container"><view wx:if="{{loading}}" class="loading">加载中…</view><view wx:elif="{{error}}" class="empty">{{error}}<button class="secondary" bindtap="load">重新加载</button></view><block wx:elif="{{product}}"><swiper class="detail-photos" indicator-dots circular><swiper-item wx:for="{{product.photos}}" wx:key="id"><image src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"/></swiper-item></swiper><view class="section-title">{{product.title}}</view><text class="price">¥{{product.priceLabel}}</text><view class="facts"><text class="tag">{{product.category}}</text><text class="tag">数量 {{product.quantity}}</text><text class="tag">{{product.delivery === 'pickup' ? '校园自取' : '卖家送达'}}</text><text class="tag">{{product.statusLabel}}</text></view><view class="section-title">关于这件好物</view><view class="description">{{product.description}}</view><view class="muted">发布者：{{product.seller_name}} · 无平台佣金</view><view wx:if="{{product.review_note}}" class="error">审核说明：{{product.review_note}}</view><view wx:if="{{product.can_contact}}" class="detail-bottom"><button class="primary" bindtap="contact">联系卖家 ↗</button><button class="secondary" bindtap="favorite" disabled="{{busy}}">{{product.is_favorite ? '♥ 已收藏' : '♡ 收藏'}}</button></view><view wx:else class="empty">商品尚未公开展示或已结束售卖</view><view wx:if="{{contact}}" class="contact"><view>{{contact.contact_type === 'wechat' ? '微信号' : '手机号'}}：{{contact.contact_value}}</view><view>{{contact.delivery === 'pickup' ? '自取地点' : '送达说明'}}：{{contact.location || '请与卖家协商'}}</view><button class="secondary" size="mini" bindtap="copyContact">复制联系方式</button></view><view class="muted notice">建议公共场所当面验货，自行协商付款。请勿提前向陌生人支付定金。</view><button wx:if="{{product.status === 'active'}}" class="text-button" bindtap="report">举报此商品</button></block></view>
