.tabs{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:flex-start;height:130rpx;padding:16rpx 16rpx env(safe-area-inset-bottom);background:#fafbf6;border-top:1rpx solid #e3e9d9;z-index:20;box-sizing:content-box}.tab{width:20%;display:flex;flex-direction:column;align-items:center;font-size:20rpx;color:#99a48d;gap:6rpx}.icon{font-size:44rpx;line-height:48rpx}.active{color:#315b45}.publish{margin-top:-48rpx;width:116rpx;height:116rpx;border:8rpx solid #f7f8f2;border-radius:50%;background:#315b45;color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 8rpx 20rpx #315b4520}.plus{font-size:48rpx;line-height:50rpx}
.icon{width:44rpx;height:44rpx}
